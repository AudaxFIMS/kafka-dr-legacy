<?xml version="1.0" encoding="UTF-8"?>
<!-- shutdownHook="disable": Log4j's own hook would run in parallel with the application's
     shutdown hook and stop logging before components finish closing. KafkaDrApplication.main
     calls LogManager.shutdown() after app.stop() instead. -->
<Configuration status="WARN" shutdownHook="disable">
    <Appenders>
        <Console name="STDOUT" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>
        </Console>
    </Appenders>

    <Loggers>
        <Logger name="com.example.kafkadr" level="DEBUG" additivity="false">
            <AppenderRef ref="STDOUT"/>
        </Logger>
        <Logger name="org.apache.kafka" level="WARN" additivity="false">
            <AppenderRef ref="STDOUT"/>
        </Logger>
        <Root level="INFO">
            <AppenderRef ref="STDOUT"/>
        </Root>
    </Loggers>
</Configuration>
